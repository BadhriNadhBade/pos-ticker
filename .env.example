# Copy to .env and chmod 600
# All settings below except ADMIN_KEY/SMTP_* can also be changed at runtime
# via the admin UI at /admin or PATCH /settings — changes persist in SQLite.

# ── Required ──────────────────────────────────────────────────────────────────
ADMIN_KEY=change-me-to-a-long-random-string

# ── Email notifications ───────────────────────────────────────────────────────
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
NOTIFY_EMAIL=you@gmail.com

# ── Printer connection (auto = Ethernet first, USB fallback) ──────────────────
PRINTER_MODE=auto          # auto | usb | network
PRINTER_HOST=              # printer IP for network mode, e.g. 192.168.1.100
PRINTER_PORT=9100          # ESC/POS default
PRINTER_USB_VENDOR=0x0525  # lsusb vendor ID  (run: lsusb | grep -i print)
PRINTER_USB_PRODUCT=0xa700 # lsusb product ID
PRINTER_WIDTH_PX=384       # printable width in pixels (58mm≈384, 80mm≈576)

# ── Rate limits & format (editable at runtime via admin UI) ──────────────────
PRINTS_PER_HOUR=10
MAX_PER_IP_HOUR=3
LINE_WIDTH=32
ALLOWED_ORIGIN=https://your-domain.com
EMAIL_NOTIFICATIONS=true

# ── OpenTelemetry (optional — enable for Datadog / Jaeger / Grafana Cloud) ───
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=printer-server
