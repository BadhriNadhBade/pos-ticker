# Copy to .env and chmod 600
# All settings below except ADMIN_KEY/SMTP_* can also be changed at runtime
# via the admin UI at /admin or PATCH /settings — changes persist in SQLite.

# ── Required ──────────────────────────────────────────────────────────────────
ADMIN_KEY=change-me-to-a-long-random-string

# ── Email notifications ───────────────────────────────────────────────────────
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
NOTIFY_EMAIL=you@gmail.com

# ── Printer connection (auto = Ethernet first, USB fallback) ──────────────────
PRINTER_MODE=auto          # auto | usb | network
PRINTER_HOST=              # printer IP for network mode, e.g. 192.168.1.100
PRINTER_PORT=9100          # ESC/POS default
PRINTER_USB_VENDOR=0x0525  # lsusb vendor ID  (run: lsusb | grep -i print)
PRINTER_USB_PRODUCT=0xa700 # lsusb product ID
PRINTER_WIDTH_PX=576       # message-image width in px (80mm≈576, 58mm≈384) — must match the printer head

# ── Rate limits (editable at runtime via admin UI) ───────────────────────────
PRINTS_PER_HOUR=10
MAX_PER_IP_HOUR=3
LINE_WIDTH=48              # rule/text width in chars (80mm≈48, 58mm≈32)
ALLOWED_ORIGIN=https://your-domain.com
EMAIL_NOTIFICATIONS=true

# ── Receipt format (env-only — no admin UI; restart to apply) ────────────────
RECEIPT_TITLE=             # centered title; blank → "NEW MESSAGE"
RECEIPT_FOOTER=            # centered footer; blank → "THANK YOU"
RECEIPT_FONT=receipt       # message font: receipt | mono | sans | serif
RECEIPT_FONT_SIZE=22       # message font size in px
RECEIPT_SHOW_TIMESTAMP=true
RECEIPT_SHOW_EMAIL=true
RECEIPT_SHOW_ID=true

# ── Proxy trust ──────────────────────────────────────────────────────────────
# Set true only when running behind a trusted reverse proxy (Cloudflare, nginx)
# that injects CF-Connecting-IP or X-Forwarded-For. Default false = use the
# direct socket IP so those headers cannot be spoofed to bypass rate limiting.
TRUST_PROXY=false

# ── OpenTelemetry (optional — enable for Datadog / Jaeger / Grafana Cloud) ───
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=printer-server
