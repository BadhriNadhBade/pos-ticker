# Copy to .env and chmod 600 (setup.sh does both and generates ADMIN_KEY).
#
# Format rules (the same file is read by docker compose AND by systemd):
#   * KEY=value, one per line, comments on their OWN lines (no trailing "# ...").
#   * No spaces around "=". Avoid  $  "  '  \  #  and spaces inside values.
#
# Most limit/printer/origin settings below only seed the SQLite settings table on
# first run; afterwards edit them in the admin UI (Settings tab) or PATCH /settings.

# ── Required ──────────────────────────────────────────────────────────────────
# At least 16 characters; the server refuses to start otherwise.
# Generate one with:  openssl rand -hex 24
ADMIN_KEY=

# ── Listeners ─────────────────────────────────────────────────────────────────
# PUBLIC listener: POST /contact and GET /contact/count only. This is the only
#   thing a Cloudflare Tunnel should ever point at.
# ADMIN listener: admin UI, API and /metrics. LAN / Tailscale only.
#
# Single-binary / systemd installs read these two. Docker compose ignores them
# (it forces 0.0.0.0 inside the container) and uses ADMIN_BIND / PUBLIC_BIND below.
PUBLIC_ADDR=127.0.0.1:8080
ADMIN_ADDR=127.0.0.1:8000

# Docker compose only: host interface the published ports bind to.
# Tailscale access to the admin UI: set ADMIN_BIND to this host's `tailscale ip -4`.
# ADMIN_BIND=127.0.0.1
# PUBLIC_BIND=127.0.0.1

# ── Display ───────────────────────────────────────────────────────────────────
# IANA timezone used to format receipt timestamps (tzdata is built into the binary).
DISPLAY_TZ=America/Los_Angeles

# ── Contact form / CORS ───────────────────────────────────────────────────────
# Exact origin of the site hosting your form. Never "*".
ALLOWED_ORIGIN=https://your-domain.com

# Set true ONLY behind a trusted proxy that sets Cf-Connecting-Ip / X-Forwarded-For
# (Cloudflare Tunnel, Caddy, nginx). Leave false for direct exposure so those
# headers cannot be spoofed to dodge rate limits. Applies to the PUBLIC listener
# only, and the headers are honoured only when the TCP peer is a private or
# loopback address (the tunnel container / local proxy).
TRUST_PROXY=false

# Optional: extra Host header values the ADMIN listener accepts (comma-separated),
# e.g. your Tailscale name. Guards against DNS-rebinding; loopback is always allowed.
# ADMIN_ALLOWED_HOSTS=pi.tailnet-name.ts.net

# ── Rate limits & format (editable at runtime) ───────────────────────────────
PRINTS_PER_HOUR=10
MAX_PER_IP_HOUR=3
LINE_WIDTH=32

# ── Email notifications (optional, Gmail app password) ───────────────────────
EMAIL_NOTIFICATIONS=false
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# ── Printer ───────────────────────────────────────────────────────────────────
# auto = network first if PRINTER_HOST is set, then USB fallback; usb | network force one.
PRINTER_MODE=auto
# Network printers: IP and ESC/POS TCP port.
PRINTER_HOST=
PRINTER_PORT=9100
# Printable width in pixels: 58 mm = 384, 80 mm = 576.
PRINTER_WIDTH_PX=384

# USB printers use the kernel usblp driver (/dev/usb/lp*); no libusb involved.
# By default the app finds the device by matching these IDs (see: lsusb) against
# /sys/class/usbmisc/lp*/device/..
PRINTER_USB_VENDOR=0x0525
PRINTER_USB_PRODUCT=0xa700
# Explicit device node; overrides the vendor/product search. With docker compose
# (docker-compose.usb.yml) this exact node is the ONLY device passed to the
# container, so set it here if your printer is not /dev/usb/lp0.
# PRINTER_USB_DEVICE=/dev/usb/lp0
# Numeric gid of the host `lp` group (getent group lp); docker-compose.usb.yml
# adds it to the container so uid 65532 can open the device. setup.sh sets this.
# PRINTER_GID=7

# ── Cloudflare Tunnel (compose profile: tunnel) ──────────────────────────────
# Token of a remotely-managed tunnel (Zero Trust dashboard -> Networks -> Tunnels).
# In the dashboard map your public hostname to  http://printer:8080  (NOT :8000).
# Enable with COMPOSE_PROFILES=tunnel or `docker compose --profile tunnel up -d`.
# Compose hands this token ONLY to the cloudflared container; the printer
# container gets an explicit list of variables, not this whole file.
TUNNEL_TOKEN=

# ── Observability (compose profile: observability) ───────────────────────────
# Starts Prometheus (127.0.0.1:9090), node-exporter and an OpenTelemetry
# collector. They scrape printer:8000/metrics with ADMIN_KEY; the app itself has
# no OpenTelemetry SDK and pushes nothing. Nothing here starts by default.
# COMPOSE_PROFILES=tunnel,observability
# Optional backend credentials for otel-collector.yml:
# DD_API_KEY=
# GRAFANA_OTLP_TOKEN=

# ── Compose plumbing ──
# Image tag for the printer service (never :latest). Defaults to the `main`
# build; for reproducible installs pin a release and its digest:
# POS_TICKER_TAG=v1.0.0@sha256:<digest>
────────────────────────────────────────────────────────
# USB printer passthrough (see docker-compose.usb.yml). setup.sh sets this when
# it finds a /dev/usb/lp* device.
# COMPOSE_FILE=docker-compose.yml:docker-compose.usb.yml

# ── Advanced (defaults shown; usually leave alone) ───────────────────────────
# MAX_MESSAGE_CHARS=500
# MAX_SUBMISSIONS_PER_HOUR=
# MAX_PENDING_ROWS=
# Allow a network printer on a loopback address (testing only).
# PRINTER_ALLOW_LOOPBACK=false
# NOTIFY_MAX_PER_HOUR=20      # cap on notification e-mails per rolling hour (0 = default 20)
# MAX_IMAGE_BYTES=10485760
# MAX_IMAGE_PIXELS=24000000
# MAX_IMAGE_HEIGHT=1200
# IMAGE_BAND_PX=128
# IMAGE_BAND_PAUSE=0.2
# ASCII_LINE_SPACING=18
